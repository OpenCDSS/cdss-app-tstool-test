# Test iterating through a For() loop using a list of strings:
# - include empty values, allowed in TSTool 15.3.3
# - for output, append the property value to a file
StartLog(LogFile="Results/test-For-ListString-Blank.tstool.log")
RemoveFile(InputFile="Results/test-For-ListString-Blank-out.txt",IfNotFound="Ignore")
ReadTableFromDelimitedFile(TableID="Table1",InputFile="Data\testtable.csv")
# Skip Station2.
For(Name="TestFor",List="Station1,,Station3,Station4")
    WritePropertiesToFile(OutputFile="Results/test-For-ListString-Blank-out.txt",IncludeProperties="TestFor",WriteMode="Append",FileFormat="NameTypeValue")
EndFor(Name="TestFor")
# Uncomment the following to generate the expected results.
# CopyFile(InputFile="Results\test-For-ListString-Blank-out.txt",OutputFile="ExpectedResults\test-For-ListString-Blank-out.txt",IfInputNotFound="Fail")
# Do regression comparison with the original input
CompareFiles(InputFile1="ExpectedResults/test-For-ListString-Blank-out.txt",InputFile2="Results/test-For-ListString-Blank-out.txt",IfDifferent="Warn")
