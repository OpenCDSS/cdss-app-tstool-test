# Create a raster graph from a 15Minute time series:
# - 15Minute interval
# - single time series
# - color based on the data values
# - specify the symbol table in the product file
StartLog(LogFile="Results/test-ProcessRasterGraph-15Minute-single-symtable.tstool.log")
RemoveFile(InputFile="Results/test-ProcessRasterGraph-15Minute-single-symtable-out.png",IfNotFound="Ignore")
SetInputPeriod(InputStart="2021-07-01 00:00",InputEnd="2021-07-06 00:00")
# CLAFTCCO (0301200) - CACHE LA POUDRE AT CANYON MOUTH NEAR FORT COLLINS
abbrev:CLAFTCCO.DWR.DISCHRG.15Min~HydroBaseWeb
# CLAFORCO (0302900) - CACHE LA POUDRE RIVER AT FORT COLLINS, CO
#abbrev:CLAFORCO.USGS.DISCHRG.15Min~HydroBaseWeb
# Uncomment the following command to regenerate the expected results file.
ProcessRasterGraph(TSProductFile="test-ProcessRasterGraph-15Minute-single-symtable.tsp",View="False",OutputFile="Results/test-ProcessRasterGraph-15Minute-single-symtable-out.png")
# Uncomment the following command to regenerate the expected results file.
# CopyFile(InputFile="Results\test-ProcessRasterGraph-15Minute-single-symtable-out.png",OutputFile="ExpectedResults\test-ProcessRasterGraph-15Minute-single-symtable-out.png")
# CompareFiles(InputFile1="ExpectedResults\test-ProcessRasterGraph-15Minute-single-symtable-out.png",InputFile2="Results\test-ProcessRasterGraph-15Minute-single-symtable-out.png",IfDifferent="Warn")
